{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 / MSVC 2022 (Visual Studio 17 2022)",
      "description": "Requires QTDIR to point at the Qt 6 MSVC kit, e.g. D:\\Qt\\6.11.1\\msvc2022_64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QTDIR}",
        "CUTEE_BUILD_TESTS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows x64 / MinGW (verification build)",
      "description": "Requires QTDIR (MinGW kit), MINGW_BIN and NINJA_DIR environment variables; ninja is taken from MSYS2, e.g. NINJA_DIR=D:\\msys2\\ucrt64\\bin",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-mingw",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{QTDIR}",
        "CMAKE_CXX_COMPILER": "$env{MINGW_BIN}/g++.exe",
        "CMAKE_MAKE_PROGRAM": "$env{NINJA_DIR}/ninja.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
