/*
 * CUTEE light theme — the single application-wide style sheet.
 * Loaded from resources/cutee.qrc as :/styles/app.qss and applied once in
 * cutee::theme::apply(). Widgets opt into variants with the dynamic property
 * `uiRole` (see src/ui/UiKit.h) instead of local setStyleSheet() calls.
 *
 * Palette (see src/ui/Palette.h, keep both in sync):
 *   green  #C4F2C8  success / enabled / empty state
 *   purple #E6DAF7  primary action / selection
 *   lime   #E7EBC3  warning / low score rate / academic tag
 *   blue   #D8DDF0  table header / informational surface
 *   pink   #EDD1D1  danger / error / over-full score
 */

/* ---------- Base ---------- */

QWidget {
    color: #2F2C36;
}

QMainWindow,
QDialog,
QWidget#pageRoot {
    background: #F7F6FA;
}

QLabel {
    background: transparent;
}

/* ---------- Navigation sidebar ---------- */

QWidget#sidebar {
    background: #EDE9F7;
    border-right: 1px solid #DFD8EE;
}

QLabel#appTitle {
    color: #2F2C36;
    font-size: 21px;
    font-weight: bold;
}

QLabel#appSubtitle {
    color: #6A6573;
    font-size: 12px;
}

QLabel#sidebarMeta {
    color: #9A94A3;
    font-size: 12px;
}

/* Student identity block under the app title: bold second-level heading with
   the date-derived grade and target school as muted captions. */
QLabel#studentName {
    color: #2F2C36;
    font-size: 15px;
    font-weight: bold;
}

QLabel#studentGrade, QLabel#studentGoal {
    color: #6A6573;
    font-size: 12px;
}

/* Grouped navigation: top-level categories ("档案" / "考试" / "设置") plus
   their child pages. Category rows are bold non-selectable items; children
   are indented leaves with the usual hover/selected treatment. */
QTreeWidget#navTree {
    background: transparent;
    border: none;
    outline: none;
    font-size: 14px;
    color: #5A5468;
    show-decoration-selected: 0;
}

QTreeWidget#navTree::item {
    padding: 6px 8px;
    margin: 1px 4px;
    border-radius: 6px;
    color: #5A5468;
}

QTreeWidget#navTree::item:hover:!selected {
    background: #E6E0F3;
    color: #2F2C36;
}

QTreeWidget#navTree::item:selected {
    background: #E6DAF7;
    color: #4A3A6B;
    font-weight: bold;
}

QTreeWidget#navTree::branch {
    background: transparent;
}

QTreeWidget#navTree::branch:has-children:closed {
    image: url(:/icons/chevron-right.svg);
}

QTreeWidget#navTree::branch:has-children:open {
    image: url(:/icons/chevron-down.svg);
}

/* ---------- Page headings ---------- */

QLabel#pageTitle {
    color: #2F2C36;
    font-size: 20px;
    font-weight: bold;
}

QLabel#pageDescription {
    color: #6A6573;
    font-size: 12px;
}

QLabel[uiRole="section"] {
    color: #4A4655;
    font-size: 13px;
    font-weight: bold;
}

QLabel[uiRole="hint"] {
    color: #6A6573;
}

QLabel[uiRole="status"] {
    color: #6A6573;
    font-size: 12px;
}

QLabel[uiRole="error"] {
    color: #8B3E3E;
}

QLabel[uiRole="success"] {
    color: #2F6B3D;
}

/* Second-level verification window used by 导入 / 重置. */
QLabel#dangerHeading {
    color: #8B3E3E;
    font-size: 15px;
    font-weight: bold;
}

QLabel#dangerBullets {
    color: #2F2C36;
    font-size: 13px;
}

QLabel[uiRole="warning"] {
    color: #6E6420;
}

QLabel[uiRole="banner"] {
    background: #D8DDF0;
    color: #3D4876;
    border: 1px solid #C3CAE3;
    border-radius: 6px;
    padding: 10px 12px;
}

QWidget#emptyState {
    background: #FAFDF8;
    border: 1px dashed #C6E2C2;
    border-radius: 10px;
}

QLabel#emptyStateTitle {
    color: #2F6B3D;
    font-size: 15px;
    font-weight: bold;
}

/* ---------- Buttons ---------- */

QPushButton {
    background: #FFFFFF;
    border: 1px solid #DCD7E6;
    border-radius: 6px;
    padding: 5px 14px;
    min-height: 20px;
    color: #4A4655;
}

QPushButton:hover {
    background: #F4F1FA;
    border-color: #C6BEDB;
}

QPushButton:pressed {
    background: #EBE6F5;
}

QPushButton:focus {
    border-color: #A38FD0;
}

QPushButton:disabled {
    background: #F2F0F6;
    color: #A9A2B6;
    border-color: #E8E4F0;
}

QPushButton[uiRole="primary"] {
    background: #E6DAF7;
    border-color: #CFBDEC;
    color: #4A3A6B;
    font-weight: bold;
}

QPushButton[uiRole="primary"]:hover {
    background: #DCCBF5;
    border-color: #C3ADEA;
}

QPushButton[uiRole="primary"]:pressed {
    background: #D2BFEF;
    border-color: #B79FE0;
}

QPushButton[uiRole="primary"]:disabled {
    background: #F2EDFA;
    border-color: #E9E3F4;
    color: #ADA5BC;
}

QPushButton[uiRole="danger"] {
    color: #8B3E3E;
    border-color: #E8C6C6;
}

QPushButton[uiRole="danger"]:hover {
    background: #EDD1D1;
    border-color: #DDAFAF;
}

QPushButton[uiRole="danger"]:pressed {
    background: #E5C2C2;
}

QPushButton[uiRole="danger"]:disabled {
    background: #F2F0F6;
    color: #A9A2B6;
    border-color: #E8E4F0;
}

QPushButton[uiRole="ghost"] {
    background: transparent;
    border-color: transparent;
    color: #6A6573;
    padding: 4px 8px;
}

QPushButton[uiRole="ghost"]:hover {
    background: #F0EDF6;
}

/* Save action while the form has unsaved edits: light green from the palette. */
QPushButton[uiRole="save"] {
    background: #C4F2C8;
    border-color: #A9DCAE;
    color: #2F6B3D;
    font-weight: bold;
}

QPushButton[uiRole="save"]:hover {
    background: #B7EDBC;
    border-color: #97D19D;
}

QPushButton[uiRole="save"]:pressed {
    background: #A9E4AF;
    border-color: #8CC793;
}

QPushButton[uiRole="save"]:disabled {
    background: #EAF6EB;
    border-color: #D7E9D8;
    color: #9AABA0;
}

/* Passive "已保存" chip shown when the form matches the stored profile. */
QPushButton[uiRole="saved"],
QPushButton[uiRole="saved"]:disabled {
    background: #D5D5D5;
    border-color: #C6C6C6;
    color: #5F5B66;
    font-weight: normal;
}

/* ---------- Text inputs ---------- */

QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QComboBox {
    background: #FFFFFF;
    border: 1px solid #DCD7E6;
    border-radius: 6px;
    padding: 4px 8px;
    min-height: 20px;
    selection-background-color: #E6DAF7;
    selection-color: #3A2E5C;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QDateEdit:hover,
QComboBox:hover {
    border-color: #C6BEDB;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QComboBox:focus {
    border: 1px solid #A38FD0;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QDateEdit:disabled,
QComboBox:disabled {
    background: #F2F0F6;
    color: #A9A2B6;
    border-color: #E8E4F0;
}

QLineEdit[uiRole="invalid"],
QComboBox[uiRole="invalid"],
QDateEdit[uiRole="invalid"] {
    border: 1px solid #C97C7C;
    background: #FDF5F5;
}

QLineEdit:read-only {
    background: #FBFAFD;
    color: #6A6573;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    background: transparent;
    width: 20px;
}

QComboBox::down-arrow,
QDateEdit::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 9px;
    height: 9px;
}

QComboBox::down-arrow:disabled,
QDateEdit::down-arrow:disabled {
    image: url(:/icons/chevron-down-disabled.svg);
}

QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #DCD7E6;
    outline: none;
    selection-background-color: #E6DAF7;
    selection-color: #3A2E5C;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    border-left: 1px solid #E8E4F0;
    background: #F7F5FC;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 6px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    image: url(:/icons/chevron-up.svg);
    width: 8px;
    height: 8px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 8px;
    height: 8px;
}

QPlainTextEdit,
QTextEdit {
    background: #FFFFFF;
    border: 1px solid #DCD7E6;
    border-radius: 6px;
    padding: 6px;
    selection-background-color: #E6DAF7;
    selection-color: #3A2E5C;
}

QPlainTextEdit:focus,
QTextEdit:focus {
    border: 1px solid #A38FD0;
}

QPlainTextEdit#logView {
    background: #FBFAFD;
    font-family: Consolas, "Cascadia Mono", "Courier New", monospace;
    font-size: 12px;
}

QCheckBox {
    spacing: 6px;
}

QCheckBox:disabled {
    color: #A9A2B6;
}

/* ---------- Item views ---------- */

QTableView,
QTableWidget,
QListView,
QTreeView {
    background: #FFFFFF;
    alternate-background-color: #FBFAFD;
    border: 1px solid #E4E0EC;
    border-radius: 8px;
    gridline-color: #F1EEF6;
    selection-background-color: #E6DAF7;
    selection-color: #3A2E5C;
    outline: none;
}

QTableView::item,
QTableWidget::item {
    padding: 2px 6px;
}

QTableView::item:selected,
QTableWidget::item:selected {
    background: #E6DAF7;
    color: #3A2E5C;
}

QHeaderView {
    background: #D8DDF0;
    border: none;
}

QHeaderView::section {
    background: #D8DDF0;
    color: #3D4876;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #C7CEE6;
    border-bottom: 1px solid #B9C2DF;
    font-weight: bold;
}

QHeaderView::section:hover {
    background: #CFD6EC;
}

QHeaderView::up-arrow {
    image: url(:/icons/chevron-up.svg);
    width: 9px;
    height: 9px;
}

QHeaderView::down-arrow {
    image: url(:/icons/chevron-down.svg);
    width: 9px;
    height: 9px;
}

QTableCornerButton::section {
    background: #D8DDF0;
    border: none;
    border-bottom: 1px solid #B9C2DF;
}

/* ---------- Scroll bars ---------- */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px 2px 2px 0;
}

QScrollBar::handle:vertical {
    background: #D5D0E0;
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: #B3AAC4;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 0 2px 2px 2px;
}

QScrollBar::handle:horizontal {
    background: #D5D0E0;
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: #B3AAC4;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    background: transparent;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ---------- Containers ---------- */

QGroupBox {
    background: #FFFFFF;
    border: 1px solid #E4E0EC;
    border-radius: 8px;
    margin-top: 14px;
    padding: 14px 12px 12px 12px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 4px;
    color: #4A4655;
}

QFrame[card="true"] {
    background: #FFFFFF;
    border: 1px solid #E4E0EC;
    border-radius: 8px;
}

/* ---------- Tabs ---------- */

QTabWidget::pane {
    background: #FFFFFF;
    border: 1px solid #E4E0EC;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background: transparent;
    color: #6A6573;
    padding: 7px 16px;
    margin-right: 4px;
    border: 1px solid transparent;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

QTabBar::tab:hover:!selected {
    background: #F0EDF6;
    color: #2F2C36;
}

QTabBar::tab:selected {
    background: #E6DAF7;
    border-color: #D6C8EF;
    color: #4A3A6B;
    font-weight: bold;
}

QSplitter::handle {
    background: #EFECF6;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

/* ---------- Status bar, menus, tooltips ---------- */

QStatusBar {
    background: #FFFFFF;
    border-top: 1px solid #E4E0EC;
    color: #6A6573;
}

QStatusBar::item {
    border: none;
}

QMenuBar {
    background: #FFFFFF;
}

QMenu {
    background: #FFFFFF;
    border: 1px solid #DCD7E6;
    padding: 4px;
}

QMenu::item {
    padding: 6px 22px 6px 12px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: #E6DAF7;
    color: #3A2E5C;
}

QToolTip {
    background: #2E2A3A;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 8px;
}

QDialogButtonBox {
    dialogbuttonbox-buttons-have-icons: 0;
}
